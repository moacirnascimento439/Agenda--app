// =============================================================================
// Agendaí — Esquema do banco de dados (Prisma + PostgreSQL)
//
// Cada "model" vira uma tabela. Depois de alterar este arquivo, rode:
//   npx prisma migrate dev --name descricao-da-mudanca
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums (listas fixas de valores)
// -----------------------------------------------------------------------------

enum MemberRole {
  OWNER // dono do negócio: acesso total
  STAFF // funcionário: vê a própria agenda e faz check-in
}

enum PaymentPolicy {
  ONLINE_REQUIRED // só confirma depois de pagar online (Fase 2)
  DEPOSIT // cliente paga um sinal (X%) para reservar (Fase 2)
  ON_SITE // paga no local
}

enum AppointmentStatus {
  PENDENTE_PAGAMENTO
  CONFIRMADO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
  EXPIRADO
  FALTOU
  REEMBOLSADO
}

enum Plan {
  FREE
  PRO
}

// -----------------------------------------------------------------------------
// Usuários (quem faz login: donos e funcionários)
// O cliente final NÃO precisa de conta — ele fica na tabela Customer.
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String? // vazio quando o login é só pelo Google
  image        String?
  createdAt    DateTime @default(now())

  memberships   BusinessMember[]
  professionals Professional[]
}

// -----------------------------------------------------------------------------
// Negócio (o "tenant" do SaaS). Quase toda tabela tem businessId para
// garantir que um negócio nunca veja os dados de outro (multi-tenant).
// -----------------------------------------------------------------------------

model Business {
  id           String  @id @default(cuid())
  slug         String  @unique // usado no link público: agendai.com/{slug}
  name         String
  category     String
  description  String?
  logoUrl      String?
  primaryColor String  @default("#4f46e5")
  phone        String
  address      String
  city         String
  timezone     String  @default("America/Sao_Paulo")

  // Regras de agendamento
  minAdvanceMinutes Int     @default(60) // antecedência mínima para agendar
  maxAdvanceDays    Int     @default(60) // até quantos dias à frente
  cancelLimitHours  Int     @default(24) // prazo para cancelar/reagendar
  refundPolicy      String  @default("Cancelamentos com pelo menos 24h de antecedência são reembolsados integralmente.")

  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())

  members       BusinessMember[]
  services      Service[]
  professionals Professional[]
  timeOffs      TimeOff[]
  customers     Customer[]
  appointments  Appointment[]
  subscription  Subscription?
  consentLogs   ConsentLog[]
}

model BusinessMember {
  id         String     @id @default(cuid())
  role       MemberRole @default(OWNER)
  userId     String
  businessId String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

// -----------------------------------------------------------------------------
// Serviços e profissionais
// -----------------------------------------------------------------------------

model Service {
  id             String        @id @default(cuid())
  businessId     String
  name           String
  description    String?
  durationMin    Int
  priceCents     Int // dinheiro SEMPRE em centavos (inteiro) para evitar erros de arredondamento
  paymentPolicy  PaymentPolicy @default(ON_SITE)
  depositPercent Int? // usado quando paymentPolicy = DEPOSIT
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([businessId])
}

model Professional {
  id         String   @id @default(cuid())
  businessId String
  userId     String? // opcional: vincula o profissional a um login (funcionário)
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     ProfessionalService[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  appointments Appointment[]

  @@index([businessId])
}

// Tabela de ligação: quais serviços cada profissional faz (muitos-para-muitos)
model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

// Horário de trabalho: um "intervalo" por linha, em minutos desde a meia-noite.
// Ex.: segunda 09:00–12:00 e 13:00–18:00 = duas linhas com weekday = 1.
// Assim, o intervalo de almoço é simplesmente o "buraco" entre duas linhas.
model WorkingHours {
  id             String       @id @default(cuid())
  professionalId String
  weekday        Int // 0 = domingo ... 6 = sábado
  startMin       Int // 540 = 09:00
  endMin         Int // 1080 = 18:00
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
}

// Folgas, feriados e bloqueios manuais.
// professionalId vazio = vale para o negócio inteiro (ex.: feriado).
model TimeOff {
  id             String        @id @default(cuid())
  businessId     String
  professionalId String?
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
}

// -----------------------------------------------------------------------------
// Clientes finais e agendamentos
// -----------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String
  phone      String
  createdAt  DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  consentLogs  ConsentLog[]

  // O mesmo e-mail pode ser cliente de vários negócios, mas só uma vez em cada.
  @@unique([businessId, email])
}

model Appointment {
  id             String            @id @default(cuid())
  businessId     String
  serviceId      String
  professionalId String
  customerId     String
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(CONFIRMADO)
  // "Foto" do preço e da política no momento do agendamento: se o negócio
  // mudar o preço depois, o agendamento antigo não é afetado.
  priceCents     Int
  paymentPolicy  PaymentPolicy
  notes          String?
  // Token secreto e impossível de adivinhar: usado no link do cliente e no QR code.
  publicToken    String            @unique @default(cuid())
  holdExpiresAt  DateTime? // Fase 2: reserva de 15 min aguardando pagamento
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([businessId, startsAt])
  @@index([professionalId, startsAt])
}

// -----------------------------------------------------------------------------
// Fases futuras (já modeladas para não precisar reestruturar depois)
// -----------------------------------------------------------------------------

model Payment {
  id                String      @id @default(cuid())
  appointmentId     String
  provider          String      @default("mercadopago")
  providerPaymentId String?     @unique
  method            String? // pix | credit_card
  amountCents       Int
  status            String // pending | approved | rejected | refunded
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String    @id @default(cuid())
  businessId       String    @unique
  plan             Plan
  status           String // active | past_due | canceled
  providerId       String?
  currentPeriodEnd DateTime?
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// LGPD: registro de que o cliente aceitou os termos e a política de privacidade.
model ConsentLog {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  type       String // ex.: "TERMOS_E_PRIVACIDADE"
  version    String // versão do texto aceito
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}
